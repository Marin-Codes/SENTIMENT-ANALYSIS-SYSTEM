# ==============================================================================
# S.A.R.A. System Configuration Template
# Copy this file to .env and adjust the settings as needed:
# cp .env.example .env
# ==============================================================================

# NVIDIA NIM API Keys (Required for AI Reasoning / LLM responses)
# Obtain your key from https://build.nvidia.com
NVIDIA_API_KEY_NEMOTRON_3_NANO_30B_A3B=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Authentication Server Settings
AUTH_HOST=0.0.0.0
AUTH_PORT=5001
SESSION_TTL_SECONDS=28800

# Web Application Settings (Streamlit)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Machine Learning Models
# Whisper STT model size: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Hugging Face Sentiment Analysis Model
SENTIMENT_MODEL_NAME=nlptown/bert-base-multilingual-uncased-sentiment

# Performance & Logging
TF_ENABLE_ONEDNN_OPTS=0
TF_CPP_MIN_LOG_LEVEL=3
TOKENIZERS_PARALLELISM=false
