# Auto detect text files and perform LF normalization on checkin
* text=auto

# Source files
*.py text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf
.env.example text eol=lf
